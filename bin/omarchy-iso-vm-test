#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
WORK_DIR="${OMARCHY_TEST_WORK_DIR:-$ROOT/release/vm-test}"
CURRENT_LINK="$WORK_DIR/current"

usage() {
  cat <<'USAGE'
Usage:
  omarchy-iso-vm-test [run] [--iso PATH] [--no-build] [--reuse-disk] [--filesystem btrfs|zfs] [--no-interactive-on-failure]
  omarchy-iso-vm-test key KEY
  omarchy-iso-vm-test screenshot [PATH]
  omarchy-iso-vm-test screen

The run command builds the ISO from ~/src/omarchy by default,
then boots that ISO in a KVM VM with VNC visibility and drives the real installer UI.

Environment:
  OMARCHY_TEST_OMARCHY_PATH          Local Omarchy checkout (default: ~/src/omarchy)
  OMARCHY_TEST_USER                  Installer username (default: omarchy)
  OMARCHY_TEST_PASSWORD              Installer/root/encryption password (default: omarchy1)
  OMARCHY_TEST_HOSTNAME              Installed hostname (default: omarchy-test)
  OMARCHY_TEST_FILESYSTEM            Root filesystem to select: btrfs or zfs (default: btrfs)
  OMARCHY_TEST_VNC_DISPLAY           VNC display number (default: 5, port 5905)
  OMARCHY_TEST_INTERACTIVE_ON_FAILURE Keep VM open on failure (default: 1)
  OMARCHY_TEST_TIMEOUT               Install timeout in seconds (default: 7200)
  OMARCHY_TEST_POST_BOOT_VERIFY      Boot and verify installed ZFS VM after install (default: 1 for ZFS)
  OMARCHY_TEST_POST_BOOT_TIMEOUT     Post-boot verification timeout in seconds (default: 1200)

While a VM is running, connect with: vncviewer 127.0.0.1:5905
USAGE
}

hmp_send() {
  local socket="$1"
  shift
  local command="$*"

  HMP_SOCKET="$socket" HMP_COMMAND="$command" python3 <<'PY'
import os
import socket
import sys
import time

path = os.environ["HMP_SOCKET"]
command = os.environ["HMP_COMMAND"]
deadline = time.monotonic() + 10
last_error = None

while True:
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(path)
        break
    except OSError as exc:
        last_error = exc
        if time.monotonic() >= deadline:
            raise SystemExit(f"could not connect to HMP monitor {path}: {last_error}")
        time.sleep(0.1)

sock.settimeout(0.2)
try:
    while True:
        data = sock.recv(4096)
        if not data or b"(qemu)" in data:
            break
except OSError:
    pass

sock.sendall((command + "\n").encode())

output = []
deadline = time.monotonic() + 2
while time.monotonic() < deadline:
    try:
        data = sock.recv(4096)
    except OSError:
        break

    if not data:
        break

    output.append(data)
    if b"(qemu)" in data:
        break

sys.stdout.write(b"".join(output).decode("utf-8", "replace"))
PY
}

current_state_dir() {
  if [[ ! -L "$CURRENT_LINK" && ! -d "$CURRENT_LINK" ]]; then
    echo "No active VM state found at $CURRENT_LINK" >&2
    exit 1
  fi

  readlink -f "$CURRENT_LINK"
}

control_key() {
  local state_dir
  state_dir="$(current_state_dir)"

  if [[ $# -eq 0 ]]; then
    echo "Usage: omarchy-iso-vm-test key KEY" >&2
    exit 1
  fi

  hmp_send "$state_dir/monitor.sock" "sendkey $*" >/dev/null
}

control_screenshot() {
  local state_dir path
  state_dir="$(current_state_dir)"
  path="${1:-$state_dir/screenshot-$(date +%Y%m%d-%H%M%S).ppm}"

  hmp_send "$state_dir/monitor.sock" "screendump $path" >/dev/null
  echo "$path"
}

control_screen() {
  local state_dir screen_file
  state_dir="$(current_state_dir)"
  screen_file="$state_dir/screen.txt"

  if [[ ! -f "$screen_file" ]]; then
    echo "No captured tty1 screen yet: $screen_file" >&2
    exit 1
  fi

  cat "$screen_file"
}

latest_iso() {
  local latest

  if read -r latest < <(ls -t "$ROOT"/release/*.iso 2>/dev/null); then
    [[ -n "$latest" ]] || return 1
    printf '%s\n' "$latest"
  else
    return 1
  fi
}

require_command() {
  local command="$1"

  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Missing required command: $command" >&2
    return 1
  fi
}

ensure_run_dependencies() {
  local build="$1"
  local missing=0

  require_command qemu-system-x86_64 || missing=1
  require_command qemu-img || missing=1
  require_command expect || missing=1
  require_command python3 || missing=1
  if [[ "$build" == "1" ]]; then
    require_command docker || missing=1
  fi

  if [[ "$missing" == "1" ]]; then
    exit 1
  fi
}

find_first_file() {
  local path

  for path in "$@"; do
    if [[ -f "$path" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done

  return 1
}

find_qemu_data_file() {
  local data_dir name path

  while IFS= read -r data_dir; do
    for name in "$@"; do
      path="${data_dir%/}/$name"
      if [[ -f "$path" ]]; then
        printf '%s\n' "$path"
        return 0
      fi
    done
  done < <(qemu-system-x86_64 -L help 2>/dev/null || true)

  return 1
}

find_ovmf_code() {
  if [[ -n "${OMARCHY_OVMF_CODE:-}" ]]; then
    find_first_file "$OMARCHY_OVMF_CODE"
    return
  fi

  find_first_file \
    /usr/share/edk2/x64/OVMF_CODE.4m.fd \
    /usr/share/edk2/x64/OVMF_CODE.fd \
    /usr/share/edk2-ovmf/x64/OVMF_CODE.fd \
    /usr/share/qemu/edk2-x86_64-code.fd || \
    find_qemu_data_file \
      edk2-x86_64-code.fd \
      OVMF_CODE.4m.fd \
      OVMF_CODE.fd
}

find_ovmf_vars() {
  if [[ -n "${OMARCHY_OVMF_VARS:-}" ]]; then
    find_first_file "$OMARCHY_OVMF_VARS"
    return
  fi

  find_first_file \
    /usr/share/edk2/x64/OVMF_VARS.4m.fd \
    /usr/share/edk2/x64/OVMF_VARS.fd \
    /usr/share/edk2-ovmf/x64/OVMF_VARS.fd \
    /usr/share/qemu/edk2-i386-vars.fd || \
    find_qemu_data_file \
      OVMF_VARS.4m.fd \
      OVMF_VARS.fd \
      edk2-i386-vars.fd
}

write_boot_helper() {
  local state_dir="$1"
  local disk="$2"
  local ovmf_code="$3"
  local ovmf_vars="$4"
  local helper="$state_dir/boot-installed.sh"

  cat >"$helper" <<EOF
#!/bin/bash
set -euo pipefail

disk="$disk"
ovmf_vars="$ovmf_vars"
ovmf_code="\${OMARCHY_OVMF_CODE:-$ovmf_code}"
ssh_port="\${OMARCHY_VM_SSH_PORT:-2222}"
smp="\${OMARCHY_VM_SMP:-4}"
memory="\${OMARCHY_VM_MEMORY:-8192}"

echo "Booting installed Omarchy VM"
echo "Disk: \$disk"
echo "Display: QEMU GTK window"
echo "SSH forward: localhost:\$ssh_port -> guest:22"

exec qemu-system-x86_64 \
  -enable-kvm \
  -machine q35,accel=kvm \
  -cpu host \
  -smp "\$smp" \
  -m "\$memory" \
  -display gtk,gl=off,zoom-to-fit=on \
  -device virtio-vga,xres=1280,yres=800 \
  -device virtio-keyboard-pci \
  -device virtio-mouse-pci \
  -drive if=pflash,format=raw,readonly=on,file="\$ovmf_code" \
  -drive if=pflash,format=raw,file="\$ovmf_vars" \
  -drive if=none,id=vdisk,file="\$disk",format=qcow2,cache=writeback,discard=unmap \
  -device virtio-blk-pci,drive=vdisk,serial=omarchy-vm,bootindex=1 \
  -nic user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:"\$ssh_port"-:22
EOF

  chmod +x "$helper"
  bash -n "$helper"
  echo "Installed VM boot helper: $helper"
}

verify_zfs_boot() {
  local state_dir="$1"
  local disk="$2"
  local ovmf_code="$3"
  local ovmf_vars="$4"
  local test_user="$5"
  local test_password="$6"
  local test_hostname="$7"
  local ssh_port="$8"
  local smp="$9"
  local memory="${10}"
  local timeout_seconds="${11}"

  local qemu_args=(
    qemu-system-x86_64
    -enable-kvm
    -machine q35,accel=kvm
    -cpu host
    -smp "$smp"
    -m "$memory"
    -display none
    -serial stdio
    -no-reboot
    -drive if=pflash,format=raw,readonly=on,file="$ovmf_code"
    -drive if=pflash,format=raw,file="$ovmf_vars"
    -drive if=none,id=vdisk,file="$disk",format=qcow2,cache=writeback,discard=unmap
    -device virtio-blk-pci,drive=vdisk,serial=omarchy-iso-vm-test,bootindex=1
    -boot menu=off,strict=on
    -nic user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:"$ssh_port"-:22
  )

  echo "Booting installed ZFS VM for verification"
  echo "Post-boot serial log: $state_dir/post-boot-serial.log"

  expect -f - \
    "$state_dir" \
    "$test_user" \
    "$test_password" \
    "$test_hostname" \
    "$timeout_seconds" \
    "${qemu_args[@]}" <<'EXPECT'
set state_dir [lindex $argv 0]
set test_user [lindex $argv 1]
set test_password [lindex $argv 2]
set test_hostname [lindex $argv 3]
set boot_timeout [lindex $argv 4]
set qemu_argv [lrange $argv 5 end]
set verify_ok 0
set logout_started 0

log_file -a "$state_dir/post-boot-serial.log"
log_user 1
match_max 65536

proc fail {message} {
  global state_dir

  puts stderr "\nInstalled VM verification failed: $message"
  puts stderr "Artifacts: $state_dir"
  exit 1
}

proc shell_quote {value} {
  regsub -all {'} $value {'"'"'} escaped
  return "'$escaped'"
}

spawn {*}$qemu_argv
set timeout $boot_timeout

expect {
  -re {no pools available to import} {
    fail "ZFS initramfs emitted unexpected pool import message"
  }
  -re "$test_hostname login:" {
    send -- "$test_user\r"
  }
  -re {login:} {
    send -- "$test_user\r"
  }
  eof {
    fail "VM exited before installed login prompt"
  }
  timeout {
    fail "timed out waiting for installed login prompt"
  }
}

expect {
  -re {Password:} {
    send -- "$test_password\r"
  }
  eof {
    fail "VM exited before password prompt"
  }
  timeout {
    fail "timed out waiting for password prompt"
  }
}

expect {
  -re {[$#] $} {}
  -re {type=shell;cwd=} {
    after 500
  }
  eof {
    fail "VM exited before shell prompt"
  }
  timeout {
    fail "timed out waiting for shell prompt"
  }
}

send -- "stty -echo; printf '\\n__POST_VERIFY_STTY_DONE__\\n'\r"
expect {
  -re {__POST_VERIFY_STTY_DONE__} {}
  eof {
    fail "VM exited before post-boot verification stty setup"
  }
  timeout {
    fail "timed out waiting for post-boot verification stty setup"
  }
}

set verify_cmd "sudo_password=[shell_quote $test_password]; "
append verify_cmd {
(set -e
post_verify_fail_marker="__POST_VERIFY_"
post_verify_fail_marker="${post_verify_fail_marker}FAIL__"
check() {
  local description="$1" rc
  printf 'check: %s\n' "$description"
  shift
  if "$@"; then
    return 0
  fi
  rc=$?
  printf '%s check failed: %s rc=%s\n' "$post_verify_fail_marker" "$description" "$rc"
  return "$rc"
}
check_not() {
  local description="$1"
  printf 'check: not %s\n' "$description"
  shift
  if "$@"; then
    printf '%s forbidden check passed: %s\n' "$post_verify_fail_marker" "$description"
    return 1
  fi
}
printf '\n__POST_VERIFY_START__\n'
printf '%s\n' "$sudo_password" | sudo -S -p '' -v
sudo_password=
fstype=$(findmnt -n -o FSTYPE /)
printf 'root_fstype=%s\n' "$fstype"
check 'root filesystem is zfs' test "$fstype" = zfs
home_parent_source=$(findmnt -n -o SOURCE /home)
home_source=$(findmnt -n -o SOURCE "$HOME")
printf 'home_parent_source=%s\n' "$home_parent_source"
printf 'home_source=%s\n' "$home_source"
check 'home parent is zroot/data/home' test "$home_parent_source" = zroot/data/home
check 'user home is encrypted ZFS dataset' test "$home_source" = "zroot/data/home/$USER"
uname -r
check 'zpool zroot is healthy' sudo -n zpool status zroot
check 'zfs root and home datasets exist' sudo -n zfs list -H -o name,mountpoint zroot/ROOT/default zroot/data/home "zroot/data/home/$USER"
check 'user home encryption enabled' test "$(sudo -n zfs get -H -o value encryption "zroot/data/home/$USER")" != off
check 'user home keyformat is passphrase' test "$(sudo -n zfs get -H -o value keyformat "zroot/data/home/$USER")" = passphrase
check 'user home keylocation is prompt' test "$(sudo -n zfs get -H -o value keylocation "zroot/data/home/$USER")" = prompt
check 'user home key is available' test "$(sudo -n zfs get -H -o value keystatus "zroot/data/home/$USER")" = available
check 'pam_zfs_key module installed' sudo -n test -f /usr/lib/security/pam_zfs_key.so
check 'ZFS PAM file exists' sudo -n test -f /etc/pam.d/zfs-key
check 'ZFS PAM auth unlock helper exists' sudo -n test -x /usr/local/lib/omarchy/zfs-pam-unlock-home
check 'ZFS home cleanup helper exists' sudo -n test -x /usr/local/lib/omarchy/zfs-home-cleanup
check 'ZFS PAM cleanup helper exists' sudo -n test -x /usr/local/lib/omarchy/zfs-pam-cleanup-home
check 'system-login includes ZFS PAM auth' sudo -n grep -Eq '^auth[[:space:]]+include[[:space:]]+zfs-key' /etc/pam.d/system-login
check 'system-login includes ZFS PAM session' sudo -n grep -Eq '^session[[:space:]]+include[[:space:]]+zfs-key' /etc/pam.d/system-login
check 'system-auth includes ZFS PAM password sync' sudo -n grep -Eq '^password[[:space:]]+include[[:space:]]+zfs-key' /etc/pam.d/system-auth
check_not 'system-auth includes ZFS PAM auth' sudo -n grep -Eq '^auth[[:space:]]+include[[:space:]]+zfs-key' /etc/pam.d/system-auth
check_not 'system-auth includes ZFS PAM session' sudo -n grep -Eq '^session[[:space:]]+include[[:space:]]+zfs-key' /etc/pam.d/system-auth
check 'ZFS PAM auth is login-service scoped' sudo -n grep -Eq '^auth[[:space:]]+\[success=ignore default=3\][[:space:]]+pam_succeed_if\.so service in sddm:login:sshd:su-l quiet' /etc/pam.d/zfs-key
check 'ZFS PAM session is login-service scoped' sudo -n grep -Eq '^session[[:space:]]+\[success=ignore default=3\][[:space:]]+pam_succeed_if\.so service in sddm:login:sshd:su-l quiet' /etc/pam.d/zfs-key
check 'ZFS PAM skips auth hooks for system users' sudo -n grep -Eq '^auth[[:space:]]+\[default=2 success=ignore\][[:space:]]+pam_succeed_if\.so uid >= 1000 quiet' /etc/pam.d/zfs-key
check 'ZFS PAM mounts home during auth' sudo -n grep -q 'pam_exec.so expose_authtok seteuid quiet /usr/local/lib/omarchy/zfs-pam-unlock-home' /etc/pam.d/zfs-key
check 'ZFS PAM uses home dataset prefix' sudo -n grep -q 'pam_zfs_key.so homes=zroot/data/home' /etc/pam.d/zfs-key
check 'ZFS PAM schedules home cleanup on session close' sudo -n grep -q 'pam_exec.so type=close_session seteuid quiet /usr/local/lib/omarchy/zfs-pam-cleanup-home' /etc/pam.d/zfs-key
check 'hyprlock PAM uses packaged login auth' sudo -n grep -Eq '^auth[[:space:]]+include[[:space:]]+login' /etc/pam.d/hyprlock
check 'hyprlock PAM package file is unmodified' sudo -n pacman -Qkk hyprlock
check_not 'hyprlock PAM has direct ZFS stack' sudo -n grep -Eq 'zfs-key|pam_zfs_key|system-auth' /etc/pam.d/hyprlock
check_not 'SDDM autologin config exists' sudo -n test -f /etc/sddm.conf.d/autologin.conf
check 'SDDM remembers installed user' sudo -n grep -q "^User=$USER$" /var/lib/sddm/state.conf
check 'SDDM remembers Omarchy session' sudo -n grep -q '^Session=omarchy\.desktop$' /var/lib/sddm/state.conf
check 'limine config exists' sudo -n test -f /boot/limine.conf
check 'limine has entries' sudo -n grep -q '^/+' /boot/limine.conf
check 'limine uses zfs root' sudo -n grep -q 'root=ZFS=zroot/ROOT/default' /boot/limine.conf
check 'limine uses zfs boot-only import' sudo -n grep -q 'zfs_boot_only=1' /boot/limine.conf
check 'mkinitcpio hooks include zfs' sudo -n grep -q 'zfs filesystems)' /etc/mkinitcpio.conf.d/omarchy_hooks.conf
check_not 'mkinitcpio hooks include zfs fsck' sudo -n grep -q 'zfs filesystems fsck' /etc/mkinitcpio.conf.d/omarchy_hooks.conf
check 'ZFS hostid is set' bash -lc 'test "$(hostid)" = deadbeef'
check 'mkinitcpio includes ZFS hostid file' sudo -n grep -q '^FILES+=(/etc/hostid)$' /etc/mkinitcpio.conf.d/zfs_hostid.conf
check 'UKI embeds ZFS hostid' bash -lc 'shopt -s nullglob; ukis=(/boot/EFI/Linux/omarchy_*.efi); ((${#ukis[@]} > 0)); for uki in "${ukis[@]}"; do sudo -n lsinitcpio "$uki" | grep -qx etc/hostid; done'
check 'visible Omarchy source directory exists' test -d "$HOME/.local/share/omarchy"
check 'visible Omarchy install script exists' test -f "$HOME/.local/share/omarchy/install.sh"
check 'visible Hypr Lua config exists' test -f "$HOME/.config/hypr/hyprland.lua"
check 'Hypr Lua config loads user autostart' grep -q 'require("hypr.autostart")' "$HOME/.config/hypr/hyprland.lua"
check 'visible Omarchy install log exists' sudo -n test -f /var/log/omarchy-install.log
check 'archzfs repo is configured' grep -q '^\[archzfs\]' /etc/pacman.conf
check 'ZFS packages are installed' pacman -Q zfs-dkms zfs-utils limine-mkinitcpio-hook
check 'systemd-networkd is enabled' systemctl is-enabled systemd-networkd.service
check 'systemd-resolved is enabled' systemctl is-enabled systemd-resolved.service
check 'networkd config was installed' bash -lc 'compgen -G "/etc/systemd/network/*.network" >/dev/null'
check 'resolv.conf uses resolved stub' test "$(readlink -f /etc/resolv.conf)" = /run/systemd/resolve/stub-resolv.conf
check 'installed system has an IPv4 address' bash -lc "ip -4 addr show scope global | grep -q 'inet '"
check 'installed system has a default route' bash -lc "ip route show default | grep -q '^default '"
check 'sddm is enabled' systemctl is-enabled sddm.service
check_not 'swapfile is in fstab' grep -q '/swap/swapfile' /etc/fstab
check_not 'resume config exists' sudo -n test -f /etc/mkinitcpio.conf.d/omarchy_resume.conf
check 'no failed systemd units' test -z "$(systemctl --failed --no-legend)"
# Keep the home dataset busy past PAM close so the delayed cleanup path is exercised.
hold_unit="omarchy-zfs-home-hold-$$"
sudo -n systemd-run --quiet --collect --unit="$hold_unit" --property="WorkingDirectory=$HOME" /usr/bin/sleep 12
sleep 1
check 'ZFS logout verifier home hold is active' sudo -n systemctl is-active --quiet "$hold_unit.service"
sudo -n tee /run/omarchy-zfs-logout-verify >/dev/null <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

user="$1"
home="$2"
dataset="$3"
tty="${4:-/dev/ttyS0}"
uid=$(id -u "$user")
source=""
keystatus=""

user_has_sessions() {
  local session session_class sessions

  sessions=$(loginctl show-user "$user" -p Sessions --value 2>/dev/null || true)
  for session in $sessions; do
    session_class=$(loginctl show-session "$session" -p Class --value 2>/dev/null || true)
    if [[ $session_class == user || $session_class == user-early ]]; then
      return 0
    fi
  done

  return 1
}

for _ in {1..90}; do
  if user_has_sessions; then
    sleep 1
    continue
  fi

  source=$(findmnt -n -o SOURCE --target "$home" 2>/dev/null || true)
  keystatus=$(zfs get -H -o value keystatus "$dataset" 2>/dev/null || true)

  if [[ $source != "$dataset" && $keystatus == unavailable ]]; then
    printf '\n__ZFS_LOGOUT_UNMOUNT_OK__ source=%s keystatus=%s\n' "$source" "$keystatus" >"$tty" || true
    systemctl poweroff || true
    exit 0
  fi

  sleep 1
done

printf '\n__ZFS_LOGOUT_UNMOUNT_FAIL__ source=%s keystatus=%s\n' "$source" "$keystatus" >"$tty" || true
systemctl poweroff || true
exit 1
SCRIPT
sudo -n chmod 0755 /run/omarchy-zfs-logout-verify
sudo -n systemd-run --quiet --collect --unit="omarchy-zfs-logout-verify-$$" /run/omarchy-zfs-logout-verify "$USER" "$HOME" "zroot/data/home/$USER" /dev/ttyS0
printf '\n__POST_VERIFY_OK__\n')
rc=$?
sudo_password=
printf '\n__POST_VERIFY_EXIT:%s__\n' "$rc"
}
send -- "$verify_cmd\r"

set timeout $boot_timeout
expect {
  -re {__POST_VERIFY_OK__} {
    set verify_ok 1
    if {!$logout_started} {
      set logout_started 1
      send -- "exit\r"
    }
    exp_continue
  }
  -re {__POST_VERIFY_EXIT:0__} {
    set verify_ok 1
    if {!$logout_started} {
      set logout_started 1
      send -- "exit\r"
    }
    exp_continue
  }
  -re {__ZFS_LOGOUT_UNMOUNT_OK__[^\r\n]*} {
    set verify_ok 2
    exp_continue
  }
  -re {__ZFS_LOGOUT_UNMOUNT_FAIL__[^\r\n]*} {
    fail "ZFS home did not unmount after logout: $expect_out(0,string)"
  }
  -re {__POST_VERIFY_FAIL__[^\r\n]*} {
    fail "$expect_out(0,string)"
  }
  -re {__POST_VERIFY_EXIT:([1-9][0-9]*)__} {
    fail "post-boot verification command exited with failure"
  }
  eof {
    if {$verify_ok == 2} {
      puts "Installed ZFS VM boot verification passed"
      exit 0
    }

    if {$verify_ok == 1} {
      fail "VM exited before logout unmount verification completed"
    }

    fail "VM exited before post-boot verification completed"
  }
  timeout {
    fail "timed out waiting for post-boot verification"
  }
}
EXPECT
}

run_test() {
  local build=1
  local iso=""
  local reuse_disk=0
  local filesystem="${OMARCHY_TEST_FILESYSTEM:-btrfs}"
  local interactive_on_failure="${OMARCHY_TEST_INTERACTIVE_ON_FAILURE:-1}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --iso)
        iso="$2"
        build=0
        shift 2
        ;;
      --no-build)
        build=0
        shift
        ;;
      --reuse-disk)
        reuse_disk=1
        shift
        ;;
      --filesystem)
        filesystem="$2"
        shift 2
        ;;
      --no-interactive-on-failure)
        interactive_on_failure=0
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  ensure_run_dependencies "$build"

  case "$filesystem" in
    btrfs|zfs) ;;
    *)
      echo "Unsupported filesystem: $filesystem" >&2
      echo "Expected: btrfs or zfs" >&2
      exit 1
      ;;
  esac

  local omarchy_path="${OMARCHY_TEST_OMARCHY_PATH:-$HOME/src/omarchy}"

  if [[ "$build" == "1" ]]; then
    if [[ ! -d "$omarchy_path" ]]; then
      echo "Local Omarchy source not found: $omarchy_path" >&2
      echo "Set OMARCHY_PATH or check out Omarchy at ~/src/omarchy." >&2
      exit 1
    fi

    echo "Building ISO from local Omarchy source: $omarchy_path"
    OMARCHY_PATH="$omarchy_path" "$SCRIPT_DIR/omarchy-iso-make" --local-source --no-cache --no-boot-offer
    iso="$(latest_iso)"
  elif [[ -z "$iso" ]]; then
    iso="$(latest_iso)"
  fi

  if [[ ! -f "$iso" ]]; then
    echo "ISO not found: $iso" >&2
    exit 1
  fi

  if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
    echo "KVM is required for this VM test, but /dev/kvm is not readable/writable." >&2
    exit 1
  fi

  local timestamp state_dir disk ovmf_code ovmf_vars_template ovmf_vars
  timestamp="$(date +%Y%m%d-%H%M%S)"
  state_dir="$WORK_DIR/$timestamp"
  mkdir -p "$state_dir"
  ln -sfnT "$state_dir" "$CURRENT_LINK"

  if [[ "$reuse_disk" == "1" ]]; then
    disk="$WORK_DIR/reusable.qcow2"
  else
    disk="$state_dir/omarchy-test.qcow2"
  fi

  if [[ ! -f "$disk" ]]; then
    qemu-img create -f qcow2 "$disk" "${OMARCHY_TEST_DISK_SIZE:-80G}" >/dev/null
  fi

  ovmf_code="$(find_ovmf_code)" || {
    echo "Could not find OVMF_CODE firmware. Set OMARCHY_OVMF_CODE." >&2
    exit 1
  }

  ovmf_vars_template="$(find_ovmf_vars)" || {
    echo "Could not find OVMF_VARS firmware. Set OMARCHY_OVMF_VARS." >&2
    exit 1
  }

  ovmf_vars="$state_dir/OVMF_VARS.fd"
  cp "$ovmf_vars_template" "$ovmf_vars"
  chmod u+w "$ovmf_vars"

  local hmp_socket vnc_display vnc_port ssh_port width height smp memory timeout_seconds post_boot_timeout_seconds
  hmp_socket="$state_dir/monitor.sock"
  vnc_display="${OMARCHY_TEST_VNC_DISPLAY:-5}"
  vnc_port=$((5900 + vnc_display))
  ssh_port="${OMARCHY_TEST_SSH_PORT:-2222}"
  width="${OMARCHY_TEST_WIDTH:-1024}"
  height="${OMARCHY_TEST_HEIGHT:-768}"
  smp="${OMARCHY_TEST_SMP:-4}"
  memory="${OMARCHY_TEST_MEMORY:-8192}"
  timeout_seconds="${OMARCHY_TEST_TIMEOUT:-7200}"
  post_boot_timeout_seconds="${OMARCHY_TEST_POST_BOOT_TIMEOUT:-1200}"

  local qemu_args=(
    qemu-system-x86_64
    -enable-kvm
    -machine q35,accel=kvm
    -cpu host
    -smp "$smp"
    -m "$memory"
    -display none
    -vnc "127.0.0.1:$vnc_display"
    -device virtio-vga,xres="$width",yres="$height"
    -monitor "unix:$hmp_socket,server=on,wait=off"
    -serial stdio
    -no-reboot
    -drive if=pflash,format=raw,readonly=on,file="$ovmf_code"
    -drive if=pflash,format=raw,file="$ovmf_vars"
    -drive if=none,id=vdisk,file="$disk",format=qcow2,cache=writeback,discard=unmap
    -device virtio-blk-pci,drive=vdisk,serial=omarchy-iso-vm-test,bootindex=2
    -drive if=none,id=omarchyiso,file="$iso",format=raw,media=cdrom,readonly=on
    -device ide-cd,drive=omarchyiso,bus=ide.0,bootindex=1
    -boot menu=off,strict=on
    -nic user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:"$ssh_port"-:22
  )

  cat >"$state_dir/run.env" <<EOF
ISO=$iso
DISK=$disk
FILESYSTEM=$filesystem
VNC=127.0.0.1:$vnc_port
HMP_SOCKET=$hmp_socket
SERIAL_LOG=$state_dir/serial.log
SCREEN=$state_dir/screen.txt
EOF

  echo "Booting ISO VM test with KVM"
  echo "ISO: $iso"
  echo "Disk: $disk"
  echo "VNC: 127.0.0.1:$vnc_port"
  echo "Artifacts: $state_dir"

  expect -f - \
    "$hmp_socket" \
    "$state_dir" \
    "${OMARCHY_TEST_USER:-omarchy}" \
    "${OMARCHY_TEST_PASSWORD:-omarchy1}" \
    "${OMARCHY_TEST_HOSTNAME:-omarchy-test}" \
    "$filesystem" \
    "$timeout_seconds" \
    "$vnc_display" \
    "$interactive_on_failure" \
    "${OMARCHY_TEST_LOG_SERIAL_TO_STDOUT:-0}" \
    "${qemu_args[@]}" <<'EXPECT'
set hmp_socket [lindex $argv 0]
set state_dir [lindex $argv 1]
set test_user [lindex $argv 2]
set test_password [lindex $argv 3]
set test_hostname [lindex $argv 4]
set test_filesystem [lindex $argv 5]
set install_timeout [lindex $argv 6]
set vnc_display [lindex $argv 7]
set interactive_on_failure [lindex $argv 8]
set log_serial_stdout [lindex $argv 9]
set qemu_argv [lrange $argv 10 end]

set install_ok 0
set install_seen 0
set install_reboot_confirmed 0
set screen_id 0

log_file -a "$state_dir/serial.log"
log_user $log_serial_stdout
match_max -d 65536

proc hmp {command} {
  global hmp_socket

  set script {
import os
import socket
import sys
import time

path = os.environ["HMP_SOCKET"]
command = os.environ["HMP_COMMAND"]
deadline = time.monotonic() + 10
last_error = None

while True:
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(path)
        break
    except OSError as exc:
        last_error = exc
        if time.monotonic() >= deadline:
            raise SystemExit(f"could not connect to HMP monitor {path}: {last_error}")
        time.sleep(0.1)

sock.settimeout(0.2)
try:
    while True:
        data = sock.recv(4096)
        if not data or b"(qemu)" in data:
            break
except OSError:
    pass

sock.sendall((command + "\n").encode())

output = []
deadline = time.monotonic() + 2
while time.monotonic() < deadline:
    try:
        data = sock.recv(4096)
    except OSError:
        break

    if not data:
        break

    output.append(data)
    if b"(qemu)" in data:
        break

sys.stdout.write(b"".join(output).decode("utf-8", "replace"))
  }

  if {[catch {exec env HMP_SOCKET=$hmp_socket HMP_COMMAND=$command python3 -c $script} output]} {
    puts stderr "HMP command failed: $command"
    puts stderr $output
    error $output
  }

  return $output
}

proc screenshot {name} {
  global state_dir

  set safe $name
  regsub -all {[^A-Za-z0-9_.-]} $safe "_" safe
  set path "$state_dir/$safe.ppm"

  if {[catch {hmp "screendump $path"}]} {
    return ""
  }

  return $path
}

proc fail {message} {
  global interactive_on_failure state_dir vnc_display

  catch {screenshot failure}
  puts stderr "\nVM test failed: $message"
  puts stderr "VNC: 127.0.0.1:[expr {5900 + $vnc_display}]"
  puts stderr "Artifacts: $state_dir"

  if {$interactive_on_failure eq "1"} {
    puts stderr "Keeping the VM open for debugging. Use VNC for display/input; this terminal is the serial console."
    puts stderr "Quit QEMU or close this terminal to finish the failed test."
    interact
  }

  exit 1
}

proc send_key {key} {
  hmp "sendkey $key"
  after 120
}

proc key_name {char} {
  switch -- $char {
    " " { return "spc" }
    "-" { return "minus" }
    "." { return "dot" }
    "/" { return "slash" }
    "_" { return "shift-minus" }
    default {
      if {[regexp {^[a-z0-9]$} $char]} {
        return $char
      }

      error "No QEMU key mapping for character: $char"
    }
  }
}

proc type_text {text} {
  foreach char [split $text ""] {
    send_key [key_name $char]
  }
}

proc mark_install_ok {} {
  global install_ok

  if {!$install_ok} {
    puts "Detected Omarchy install completion marker"
  }

  set install_ok 1
}

proc save_screen {screen} {
  global state_dir

  set f [open "$state_dir/screen.txt" w]
  puts -nonewline $f $screen
  close $f

  set history [open "$state_dir/screen-history.log" a]
  puts $history "\n===== [clock format [clock seconds] -format {%Y-%m-%d %H:%M:%S}] ====="
  puts $history $screen
  close $history
}

proc fold_screen {screen cols} {
  if {![string is integer -strict $cols] || $cols < 1} {
    set cols 80
  }

  set out ""
  set len [string length $screen]

  for {set i 0} {$i < $len} {incr i $cols} {
    append out [string range $screen $i [expr {$i + $cols - 1}]] "\n"
  }

  return $out
}

proc read_screen {} {
  global screen_id install_ok state_dir timeout

  incr screen_id
  set done "__OMARCHY_VCS_DONE_${screen_id}__"
  send -- "cols=\$(stty size < /dev/tty1 2>/dev/null || printf '24 80'); cols=\${cols##* }; printf '\\n__OMARCHY_VCS_BEGIN_%s__\\n%s\\n' $screen_id \"\${cols:-80}\"; LC_ALL=C tr '\\000' ' ' </dev/vcs1 | base64 -w0; printf '\\n__OMARCHY_VCS_END_%s__\\n' $screen_id; printf '\\n__OMARCHY_VCS_DONE_%s__\\n' $screen_id\r"
  set output [wait_serial_marker $done "screen capture $screen_id" 1]

  if {$output eq "__EOF__"} {
    return "__EOF__"
  }

  set cols 80
  set encoded ""
  set pattern [format {__OMARCHY_VCS_BEGIN_%s__[[:space:]]+([0-9]+)[[:space:]]+([A-Za-z0-9+/=]+)[[:space:]]+__OMARCHY_VCS_END_%s__} $screen_id $screen_id]

  if {![regexp $pattern $output -> cols encoded]} {
    puts stderr "screen capture marker $screen_id was not found in serial command output"
    return ""
  }

  if {$encoded eq ""} {
    return ""
  }

  if {[catch {binary decode base64 $encoded} screen]} {
    set screen $encoded
  }

  set screen [fold_screen $screen $cols]
  save_screen $screen
  return $screen
}

proc check_fail_screen {screen} {
  if {[regexp -nocase {(Omarchy installation stopped|Traceback|==> ERROR|error: failed|failed to prepare transaction|target not found|No space left on device)} $screen]} {
    fail "installer displayed a fail-fast pattern"
  }
}

proc wait_screen {description pattern seconds} {
  global install_ok

  puts "Waiting for $description"
  set deadline [expr {[clock seconds] + $seconds}]

  while {[clock seconds] < $deadline} {
    set screen [read_screen]

    if {$screen eq "__EOF__"} {
      if {$install_ok} {
        return "eof"
      }

      fail "VM exited while waiting for $description"
    }

    check_fail_screen $screen

    if {[regexp -nocase $pattern $screen]} {
      set shot [screenshot $description]
      if {$shot ne ""} {
        puts "Captured $description screenshot: $shot"
      }
      return "matched"
    }

    after 1000
  }

  fail "timed out waiting for $description"
}

proc wait_shell_prompt {} {
  expect {
    -re {__OMARCHY_INSTALL_COMPLETED__} {
      mark_install_ok
      exp_continue
    }
    -re {__OMARCHY_PROMPT__# } {
      return $expect_out(buffer)
    }
    eof {
      fail "VM exited before serial root shell was ready"
    }
    timeout {
      fail "timed out waiting for serial root shell"
    }
  }
}

proc wait_serial_marker {marker description {allow_eof 0}} {
  expect {
    -re {__OMARCHY_INSTALL_COMPLETED__} {
      mark_install_ok
      exp_continue
    }
    -re $marker {
      return $expect_out(buffer)
    }
    eof {
      if {$allow_eof} {
        return "__EOF__"
      }
      fail "VM exited while waiting for $description"
    }
    timeout {
      fail "timed out waiting for $description"
    }
  }
}

proc start_completion_watcher {} {
  send -- "OMARCHY_TEST_TTY=\$(tty); (while true; do if test -f /mnt/var/tmp/omarchy-install-completed; then printf '\\n__OMARCHY_INSTALL_%s__\\n' COMPLETED >\"\$OMARCHY_TEST_TTY\"; break; fi; sleep 1; done) >/dev/null 2>&1 & printf '\\n__OMARCHY_WATCHER_STARTED__\\n'\r"
  wait_serial_marker "__OMARCHY_WATCHER_STARTED__" "completion watcher startup"
}

proc wait_install {seconds} {
  global install_ok install_reboot_confirmed install_seen

  puts "Waiting for Omarchy installation to finish"
  set deadline [expr {[clock seconds] + $seconds}]

  while {[clock seconds] < $deadline} {
    set screen [read_screen]

    if {$screen eq "__EOF__"} {
      if {$install_ok || $install_seen} {
        puts "VM exited after install completion"
        return
      }

      fail "VM exited before install completion marker"
    }

    if {$install_ok} {
      if {!$install_reboot_confirmed && [regexp -nocase {Reboot Now} $screen]} {
        set install_reboot_confirmed 1
        send_key ret
      }

      puts "Install completion marker reached; waiting for VM reboot exit"
      set timeout 120
      expect {
        eof {
          puts "VM exited cleanly after requested reboot"
          return
        }
        timeout {
          puts "Install VM did not exit after reboot confirmation; stopping it"
          catch {hmp "quit"}
          expect {
            eof {}
            timeout {}
          }
          return
        }
      }
    }

    check_fail_screen $screen

    if {[regexp -nocase {(Finished installing|Installed in|Installation completed without any errors|Rebooting system)} $screen]} {
      set install_seen 1
    }

    if {!$install_reboot_confirmed && [regexp -nocase {Reboot Now} $screen]} {
      set install_reboot_confirmed 1
      send_key ret
    }

    after 5000
  }

  fail "timed out waiting for Omarchy installation"
}

spawn {*}$qemu_argv
match_max 65536

set timeout 600
expect {
  -re {archiso login:} {
    send -- "root\r"
    exp_continue
  }
  -re {# } {}
  eof {
    fail "VM exited before live ISO login"
  }
  timeout {
    fail "timed out waiting for live ISO login"
  }
}

send -- "exec /bin/bash --noprofile --norc\r"
expect {
  -re {bash-[^#]*# } {}
  eof {
    fail "VM exited before bash serial shell was ready"
  }
  timeout {
    fail "timed out waiting for bash serial shell"
  }
}

send -- "export PS1='__OMARCHY_PROMPT__# '\r"
expect {
  -re {__OMARCHY_PROMPT__# } {}
  eof {
    fail "VM exited before fixed serial prompt was ready"
  }
  timeout {
    fail "timed out waiting for fixed serial prompt"
  }
}

send -- "stty -echo; printf '\\n__OMARCHY_STTY_DONE__\\n'\r"
wait_serial_marker "__OMARCHY_STTY_DONE__" "serial stty setup"
start_completion_watcher

wait_screen "keyboard layout prompt" {Select keyboard layout} 300
send_key ret

wait_screen "username prompt" {Username>} 120
type_text $test_user
send_key ret

wait_screen "password prompt" {Password>} 120
type_text $test_password
send_key ret

wait_screen "password confirmation prompt" {Confirm>} 120
type_text $test_password
send_key ret

wait_screen "full name prompt" {Full name>} 120
send_key ret

wait_screen "email prompt" {Email address>} 120
send_key ret

wait_screen "hostname prompt" {Hostname>} 120
type_text $test_hostname
send_key ret

wait_screen "timezone prompt" {Timezone} 180
send_key ret

wait_screen "summary confirmation" {Does this look right} 120
send_key y

wait_screen "disk selector" {Select install disk} 120
send_key ret

wait_screen "filesystem selector" {Select root filesystem} 120
if {$test_filesystem eq "zfs"} {
  send_key down
}
send_key ret

wait_screen "disk overwrite confirmation" {Confirm overwriting} 120
send_key y

wait_install $install_timeout
EXPECT

  if [[ "$filesystem" == "zfs" && "${OMARCHY_TEST_POST_BOOT_VERIFY:-1}" == "1" ]]; then
    verify_zfs_boot \
      "$state_dir" \
      "$disk" \
      "$ovmf_code" \
      "$ovmf_vars" \
      "${OMARCHY_TEST_USER:-omarchy}" \
      "${OMARCHY_TEST_PASSWORD:-omarchy1}" \
      "${OMARCHY_TEST_HOSTNAME:-omarchy-test}" \
      "$ssh_port" \
      "$smp" \
      "$memory" \
      "$post_boot_timeout_seconds"
  fi

  write_boot_helper "$state_dir" "$disk" "$ovmf_code" "$ovmf_vars"
}

command="${1:-run}"
case "$command" in
  run)
    shift || true
    run_test "$@"
    ;;
  --*)
    run_test "$@"
    ;;
  key)
    shift
    control_key "$@"
    ;;
  screenshot)
    shift
    control_screenshot "$@"
    ;;
  screen)
    shift
    control_screen
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
