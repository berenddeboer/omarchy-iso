#!/bin/bash

set -euo pipefail

ISO="${1:-}"
REUSE="${2:-}"
QEMU="${OMARCHY_QEMU:-qemu-system-x86_64}"

require_command() {
  local command="$1"

  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Missing required command: $command" >&2
    exit 1
  fi
}

find_first_file() {
  local path

  for path in "$@"; do
    if [[ -f "$path" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done

  return 1
}

find_qemu_data_file() {
  local data_dir name path

  while IFS= read -r data_dir; do
    for name in "$@"; do
      path="${data_dir%/}/$name"
      if [[ -f "$path" ]]; then
        printf '%s\n' "$path"
        return 0
      fi
    done
  done < <("$QEMU" -L help 2>/dev/null || true)

  return 1
}

find_ovmf_code() {
  if [[ -n "${OMARCHY_OVMF_CODE:-}" ]]; then
    find_first_file "$OMARCHY_OVMF_CODE"
    return
  fi

  find_first_file \
    /usr/share/edk2/x64/OVMF_CODE.4m.fd \
    /usr/share/edk2/x64/OVMF_CODE.fd \
    /usr/share/edk2-ovmf/x64/OVMF_CODE.fd \
    /usr/share/qemu/edk2-x86_64-code.fd || \
    find_qemu_data_file \
      edk2-x86_64-code.fd \
      OVMF_CODE.4m.fd \
      OVMF_CODE.fd
}

find_ovmf_vars() {
  if [[ -n "${OMARCHY_OVMF_VARS:-}" ]]; then
    find_first_file "$OMARCHY_OVMF_VARS"
    return
  fi

  find_first_file \
    /usr/share/edk2/x64/OVMF_VARS.4m.fd \
    /usr/share/edk2/x64/OVMF_VARS.fd \
    /usr/share/edk2-ovmf/x64/OVMF_VARS.fd \
    /usr/share/qemu/edk2-i386-vars.fd || \
    find_qemu_data_file \
      OVMF_VARS.4m.fd \
      OVMF_VARS.fd \
      edk2-i386-vars.fd
}

if [ $# -eq 0 ]; then
  ISO=$(ls -t release/*.iso 2>/dev/null | gum choose --header "Select ISO to boot" || true)
  if [[ -n "$ISO" ]] && gum confirm --default=false "Reuse existing disk?"; then
    REUSE="reuse"
  fi
fi

if [ -z "$ISO" ]; then
  echo "Usage: omarchy-iso-boot [release/omarchy.iso] [reuse]"
  echo "  SSH available at: ssh -p 2222 root@localhost (after installing openssh)"
  exit 1
fi

require_command "$QEMU"
require_command qemu-img

OVMF_CODE="$(find_ovmf_code)" || {
  echo "Could not find OVMF_CODE firmware. Set OMARCHY_OVMF_CODE." >&2
  exit 1
}

OVMF_VARS_TEMPLATE="$(find_ovmf_vars)" || {
  echo "Could not find OVMF_VARS firmware. Set OMARCHY_OVMF_VARS." >&2
  exit 1
}

if [[ -z ${WAYLAND_DISPLAY:-} && -z ${DISPLAY:-} ]]; then
  while IFS='=' read -r name value; do
    case "$name" in
      WAYLAND_DISPLAY|DISPLAY|XAUTHORITY|XDG_SESSION_TYPE)
        export "$name=$value"
        ;;
    esac
  done < <(systemctl --user show-environment 2>/dev/null || true)
fi

if [[ -z ${WAYLAND_DISPLAY:-} && -z ${DISPLAY:-} ]]; then
  echo "Unable to find a graphical session for QEMU." >&2
  echo "Run omarchy-iso-boot from the Omarchy desktop session." >&2
  exit 1
fi

DISK="/tmp/omarchy-iso-boot.qcow2"
BOOT_OPTION="menu=on"
if [[ ! -f $DISK || $REUSE != "reuse" ]]; then
  qemu-img create -f qcow2 "$DISK" 40G
  cp "$OVMF_VARS_TEMPLATE" /tmp/OVMF_VARS.4m.fd
  BOOT_OPTION="once=d,menu=on"
fi

# Boot the ISO once for installation, then prefer the installed disk after reboot.
"$QEMU" \
  -cpu host -enable-kvm -machine q35,accel=kvm \
  -smp "$(nproc)" \
  -m 8192 \
  -drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
  -drive if=pflash,format=raw,file=/tmp/OVMF_VARS.4m.fd \
  -drive file="$DISK",format=qcow2,if=none,id=drive0 \
  -device virtio-blk-pci,drive=drive0,bootindex=1 \
  -drive file="$ISO",media=cdrom,if=none,format=raw,id=cdrom0 \
  -device ide-cd,drive=cdrom0,bootindex=2 \
  -device virtio-vga-gl \
  -display sdl,gl=on \
  -usb -device usb-tablet \
  -netdev user,id=net0,hostfwd=tcp::2222-:22 \
  -device virtio-net-pci,netdev=net0 \
  -boot "$BOOT_OPTION"
